# AeroDataBox RapidAPI Configuration
RAPIDAPI_KEY=your_rapidapi_key_here

# Database Configuration
# Supported values for DB_TYPE: sqlite, postgresql, mysql
DB_TYPE=postgresql

# SQLite Configuration (Only if DB_TYPE=sqlite)
SQLITE_PATH=flights.db

# PostgreSQL/MySQL Configuration (Only if DB_TYPE=postgresql or mysql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flight_analytics
DB_USER=postgres
DB_PASSWORD=secret
